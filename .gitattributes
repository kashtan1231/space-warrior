# Normalize line endings for text-based Godot files
*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.import  text eol=lf
*.cfg     text eol=lf
*.godot   text eol=lf
*.uid     text eol=lf
*.md      text eol=lf

# Binary assets
*.png     binary
*.jpg     binary
*.ogg     binary
*.wav     binary
