extends Node2D
class_name RocketCooldownBar

## Шкала готовности ракетной системы на ракетной панели. Пуск обнуляет её, дальше она
## наполняется слева направо и к моменту полной заливки ракеты снова можно пускать.
##
## Пустой боезапас опустошает шкалу целиком: пускать нечего, и полная полоса врала бы
## о готовности. Поэтому шкала слушает корабль двумя сигналами — про отсчёт задержки
## и про остаток ракет, — и показывает заливку, только когда в шахтах что-то есть.
##
## Сама ничего не отсчитывает: корабль шлёт долю готовности сигналом rocket_charge_changed,
## шкала только показывает её. Отсюда и отсутствие _process — рисовать заново есть смысл
## лишь тогда, когда пришло новое значение.
##
## Слоёв два, как у шкалы нырка: Frame — пустой жёлоб целиком, Fill — полоса заливки
## поверх него, только внутренняя часть без рамки. Код меняет ширину региона Fill,
## поэтому тёмные перепонки между сегментами просвечивают из жёлоба сами собой.
## Ширина полной заливки читается из региона в инспекторе, и длина бара коду не важна.

## Период одного деления шкалы в пикселях исходного рисунка: светлая полоска плюс тёмная
## перепонка за ней. Меряется от левого края деления до левого края следующего, поэтому
## перепонка входит в число. Перерисуешь спрайт с другими делениями — поправь здесь,
## иначе край заливки начнёт вставать посреди деления.
@export_range(1, 16, 1) var segment_step := 3
## На сколько делений сдвигается край заливки за раз. 1 — загорается каждое деление,
## 2 — через одно, и так далее. Скорость шкалы от шага не меняется: чем больше шаг,
## тем реже и крупнее прыжки. Считается в делениях, а не в пикселях, поэтому любое
## значение оставляет деления целыми.
@export_range(1, 8, 1) var fill_step := 1

@onready var fill: Sprite2D = $Fill

# Полный регион заливки из инспектора; код меняет только его ширину.
var _full_region := Rect2()
# Готовность к следующему пуску: 0 — ракета только что ушла, 1 — можно пускать.
var _charge := 1.0
# Осталась ли в шахтах хоть одна ракета.
var _loaded := false


func _ready() -> void:
	var player := get_tree().get_first_node_in_group("player")
	player.rocket_charge_changed.connect(_on_player_rocket_charge_changed)
	player.rockets_changed.connect(_on_player_rockets_changed)
	_full_region = fill.region_rect
	# Корабль стоит в дереве выше и свой стартовый сигнал шлёт ещё до _ready шкалы,
	# поэтому начальный боезапас забирается напрямую — как в rocket_panel.gd.
	_loaded = player.get_rocket_states().has(true)
	_redraw()


func _on_player_rocket_charge_changed(charge: float) -> void:
	_charge = charge
	_redraw()


func _on_player_rockets_changed(loaded: Array[bool]) -> void:
	_loaded = loaded.has(true)
	_redraw()


# Пустые шахты гасят шкалу целиком, не трогая сам отсчёт: ракеты кончились, и показывать
# готовность к пуску, которого не будет, незачем. Прокачка вернёт заливку на место.
func _redraw() -> void:
	_set_fill_width(_charge if _loaded else 0.0)


# Открывает полосу заливки на долю fraction её полной ширины. Ширина считается в целых
# делениях и только потом переводится в пиксели, поэтому край заливки всегда встаёт
# на границу деления, а не посреди светлой полоски. Округление вниз, а не до ближайшего:
# последнее деление загорается ровно в момент готовности, а не на кадр раньше, когда
# пускать ещё нельзя.
func _set_fill_width(fraction: float) -> void:
	var full_width := int(_full_region.size.x)
	# Неполное деление в хвосте спрайта не считается: его всё равно нечем зажечь целиком.
	var segments := full_width / segment_step
	var width := floori(segments * fraction / fill_step) * fill_step * segment_step
	# Полная шкала рисуется целиком, даже если её ширина не делится на шаг нацело.
	if fraction >= 1.0:
		width = full_width
	var region := _full_region
	region.size.x = width
	fill.region_rect = region
	# Регион нулевой ширины Sprite2D рисовать не должен, но надёжнее просто спрятать спрайт.
	fill.visible = region.size.x > 0.0
