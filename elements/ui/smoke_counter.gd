extends Label
class_name SmokeCounter

## Отладочная строка с числом клубов дыма: сколько их сейчас, сколько было в пике с начала
## уровня и каков потолок max_puffs. Пик нужен, чтобы ловить залпы: пока переводишь взгляд
## на строку, текущее число успевает упасть, а пик остаётся и показывает, насколько близко
## дым подходил к потолку.
##
## Узел кладётся в слой интерфейса и сам находит дым по группе. Чтобы убрать строку с экрана,
## достаточно снять галочку Visible: спрятанный узел перестаёт и обновляться.

## Как часто обновляется строка, секунд. 0 — каждый кадр, тогда цифры дёргаются так,
## что их не прочитать. Больше — спокойнее, но короткий всплеск можно и не разглядеть:
## его всё равно поймает пик.
@export var update_interval := 0.1

@onready var smoke: Smoke = get_tree().get_first_node_in_group(Smoke.GROUP)

var _time_left := 0.0


func _process(delta: float) -> void:
	# Скрытые узлы в Godot продолжают получать _process, поэтому невидимость проверяется руками.
	if not visible:
		return
	_time_left -= delta
	if _time_left > 0.0:
		return
	_time_left = update_interval
	text = "дым %d / пик %d из %d" % [smoke.get_puff_count(), smoke.get_peak_puff_count(),
			smoke.max_puffs]
