extends Node2D
class_name TorpedoBay

## Отсек бомбардировщика: пусковая с торпедой и лампочка рядом с ней. Пока торпеда
## на месте, лампочка зелёная; как только торпеда ушла — красная, и такой остаётся:
## боезапас конечный, перезарядки у бомбардировщика нет.
##
## Лампочка лежит рядом с пусковой, а не внутри неё, потому что после пуска пусковая
## прячется целиком (см. rocket_launcher.gd) — вместе с ней пропала бы и лампочка,
## хотя показывать пустой отсек должна как раз она.

# Кадры индикатора: зелёный — торпеда в отсеке, красный — отсек пуст. В самой картинке
# лампочки стоят несимметрично, поэтому в сцене кадры нарезаются не из всей текстуры,
# а из региона вокруг обеих ламп: иначе красная вставала бы на пиксель левее зелёной.
const LOADED_FRAME := 0
const EMPTY_FRAME := 1

@onready var launcher: RocketLauncher = $Launcher
@onready var indicator: Sprite2D = $Indicator


## Есть ли в отсеке торпеда.
func is_loaded() -> bool:
	return launcher.is_loaded()


## Заряжает отсек или оставляет его пустым с самого начала. Пустой не показывает торпеду
## и горит красным: так бомбардировщик несёт меньше торпед, чем у него отсеков,
## без правки сцены.
func set_loaded(loaded: bool) -> void:
	launcher.set_open(loaded)
	indicator.frame = LOADED_FRAME if loaded else EMPTY_FRAME


## Пускает торпеду по цели. Сам снаряд появится позже, на кадре вылета из анимации пуска.
func launch(target: Node2D) -> void:
	launcher.launch(target)
	indicator.frame = EMPTY_FRAME
