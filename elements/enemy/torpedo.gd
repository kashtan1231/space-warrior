extends Rocket
class_name Torpedo

## Торпеда бомбардировщика. Устроена как ракета игрока и настраивается теми же полями,
## но в своей сцене: скорость, урон, поворотливость, вид пуска и эффекты попадания
## правятся отдельно и на ракету игрока не влияют.
##
## Наводится торпеда на корабль игрока, а бьёт всех подряд: маска столкновений в сцене
## включает и вражеский слой, поэтому союзник, попавшийся на пути, получает тот же урон.
## Из-за этого бомбардировщик и ждёт свободной полосы, прежде чем пускать,
## см. torpedo_bomber.gd.

# По этой группе торпеда находит корабль игрока и считает цель живой.
const PLAYER_GROUP := &"player"
# Своя группа снарядов: среди ракет игрока торпеде делать нечего — по той группе враги
# ищут, от чего уворачиваться, а торпеда и есть оружие этих самых врагов.
const TORPEDO_GROUP := &"enemy_torpedoes"


func _projectile_group() -> StringName:
	return TORPEDO_GROUP


func _target_group() -> StringName:
	return PLAYER_GROUP


# В нырке корабль уходит с плоскости боя, и торпеда теряет его из виду: доворот замирает,
# торпеда идёт прямо. Цель при этом остаётся за ней — вынырнувший игрок, если он ещё
# впереди и не ушёл за lose_angle, снова попадает под наведение.
func _is_target_visible() -> bool:
	var ship := target as Spaceship
	return not ship.is_dodging()
