extends AnimatedSprite2D
class_name ShipEngine

## Двигатель корабля: пламя и дымный выхлоп в одном узле. Узел-компонент: скрипт вешается
## на спрайт сопла в сцене корабля. Каждый двигатель держит своё состояние сам, поэтому
## кораблю достаточно сказать ему, дан ли форсаж; что при этом играет и какой идёт дым,
## решает двигатель.
##
## Состояний два, и у каждого своё сопло — дочерний узел SmokeTrail (см. smoke_trail.gd):
## SmokeIdle для обычной работы, SmokeBoost для форсажа. Дымит всегда ровно одно из них,
## поэтому каждое настраивается независимо и целиком: от плотности и времени жизни клуба
## до положения среза, а у форсажного пламени он ниже, чем у обычного. Анимации двигатель
## берёт из своих SpriteFrames, так что в них обязаны быть обе — idle и boost.
##
## Сопло, которое включается, выбрасывает своё облако зажигания, поэтому хлопок дыма
## в момент форсажа — это поле ignition_burst форсажного сопла, а не отдельная настройка
## двигателя. Ноль у обычного сопла значит, что ни на старте уровня, ни при всплытии
## из нырка облака не будет.
##
## Класс назван ShipEngine, а не Engine: Engine — встроенный синглтон движка, и это имя
## заняло бы его.

# Анимации, которые двигатель ищет в SpriteFrames узла.
const IDLE := &"idle"
const BOOST := &"boost"

@onready var smoke_idle: SmokeTrail = $SmokeIdle
@onready var smoke_boost: SmokeTrail = $SmokeBoost

var _boosting := false
var _submerged := false
var _disabled := false


func _ready() -> void:
	# Двигатель работает с первого кадра: зажигать его нечем и незачем, в отличие
	# от ракеты, которая сходит с крыла холодной.
	_apply()


## Даёт или снимает форсаж. Корабль зовёт это каждый физический кадр, поэтому состояние
## пересобирается только на изменившемся значении.
func set_boosting(value: bool) -> void:
	if value == _boosting:
		return
	_boosting = value
	_apply()


## Уводит двигатель под дым и возвращает обратно — вместе с корпусом, см. wake.gd. Под
## дымом сопла молчат и пламя падает в холостой ход: корабль на нырке ушёл с плоскости боя,
## и струя выхлопа из-под облака читалась бы как ошибка.
func set_submerged(value: bool) -> void:
	if value == _submerged:
		return
	_submerged = value
	_apply()


## Глушит двигатель насовсем: обломки погибшего корабля дымить не должны.
func disable() -> void:
	_disabled = true
	_apply()


# Единственное место, где состояние превращается в анимацию и в работающее сопло. Поэтому
# форсажный дым не может остаться под анимацией холостого хода, а два сопла — задымить разом.
func _apply() -> void:
	var running := not _submerged and not _disabled
	var boosted := running and _boosting
	_set_trail(smoke_idle, running and not boosted)
	_set_trail(smoke_boost, boosted)
	_play(BOOST if boosted else IDLE)


# Запускается сопло через ignite, а не set_burning: так включившийся режим выбрасывает
# своё облако зажигания, и хлопок в момент форсажа настраивается полем ignition_burst
# форсажного сопла, а не кодом. Повторный ignite у уже дымящего сопла ничего не делает,
# поэтому пересборка состояния лишних хлопков не плодит.
func _set_trail(trail: SmokeTrail, burning: bool) -> void:
	if burning:
		trail.ignite()
	else:
		trail.set_burning(false)


# play() с уже играющей анимацией перезапустил бы её с первого кадра, и пламя дёргалось бы
# каждый раз, когда состояние пересобирается.
func _play(next: StringName) -> void:
	if animation != next or not is_playing():
		play(next)
