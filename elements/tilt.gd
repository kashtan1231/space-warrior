extends Node
class_name Tilt

## Ступенчатый наклон корпуса в сторону движения. Узел-компонент: кладётся в сцену
## корабля, владелец каждый физический кадр пишет в direction, куда он летит, а компонент
## сам поворачивает назначенные узлы. Игрок и враги пользуются одним кодом и отличаются
## только настройками в инспекторе.

## Узлы, которые наклоняются: спрайт корпуса и всё, что должно поворачиваться вместе
## с ним. Не сам корабль — у CharacterBody2D вместе с ним повернулся бы и хитбокс.
@export var targets: Array[Node2D]
## На сколько градусов корпус заваливается в сторону движения.
@export_range(0.0, 45.0, 1.0) var angle := 10.0
## На сколько ступенек разбит наклон в одну сторону. 2 — два промежуточных положения
## вместо плавного заваливания, в духе покадровой анимации.
@export_range(1, 6, 1) var steps := 2
## Сколько секунд держится одна ступенька наклона. Больше — корпус заваливается медленнее.
@export var step_time := 0.05
## Включить у кораблей, которые смотрят носом вниз. Без этого при полёте вправо их нос
## уходил бы влево: тот же поворот по часовой у перевёрнутого спрайта смотрит в другую сторону.
@export var nose_down := false

## Куда летит владелец: меньше нуля — влево, больше — вправо, 0 — корпус выпрямляется.
## Важен только знак, величина на угол не влияет.
var direction := 0.0

var _base_rotations: Array[float] = []
var _step := 0
var _timer := 0.0


func _ready() -> void:
	# Поворот, выставленный узлам в сцене, остаётся базой, наклон прибавляется к нему.
	for target in targets:
		_base_rotations.append(target.rotation)


# Дочерние узлы обрабатываются после родителя, поэтому direction, записанный кораблём
# в его _physics_process, применяется в этом же кадре, без отставания.
# Наклон не доезжает плавно, а переключается между целыми ступеньками не чаще, чем
# раз в step_time. Промежуточных углов не существует — корпус щёлкает из положения
# в положение, как нарисованные кадры разворота.
func _physics_process(delta: float) -> void:
	_timer -= delta
	if _timer > 0.0:
		return

	var target_step := int(signf(direction)) * steps
	if _step == target_step:
		return

	_step += signi(target_step - _step)
	_timer = step_time
	var tilt := deg_to_rad(angle) * _step / float(steps)
	if nose_down:
		tilt = -tilt
	for i in targets.size():
		targets[i].rotation = _base_rotations[i] + tilt
