shader_type canvas_item;

// Один клуб дыма. Рисует не цвет, а данные: из суммы всех клубов цвета потом получает
// smoke.gdshader на узле Smoke. Каналы цвета, который приходит из smoke.gd:
// r — плотность дыма, g — плотность его горячей части, b — плотность дыма торпеды.
//
// blend_add складывает клубы, а не кладёт верхний поверх нижнего: там, где два клуба
// перекрылись, плотность суммируется, и облако из многих клубов получается сплошным.
render_mode blend_add, unshaded;

// На краю квадрата профиль падает до exp(-4.5), примерно до 1 %: обрезка квадратом не видна.
const float EDGE_FALLOFF = 4.5;


void fragment() {
	// Координата внутри квадрата клуба, от -1 до 1 по каждой оси.
	vec2 p = UV * 2.0 - 1.0;
	// Гауссов колокол — ровно такой профиль даёт диффузия: вещество, вышедшее из точки,
	// гуще всего в середине и плавно редеет к краям.
	float profile = exp(-EDGE_FALLOFF * dot(p, p));
	COLOR = vec4(COLOR.rgb * profile, 1.0);
}
