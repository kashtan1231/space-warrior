extends Marker2D
class_name SmokeTrail

## Сопло, из которого идёт дым. Узел-компонент: ставится в сцену ракеты, торпеды или
## корабля точно на срез сопла — туда, где у спрайта кончается корпус. Дым начинается ровно
## от этого места: клуб рождается целиком позади среза, а не вокруг него, поэтому положение
## узла в редакторе совпадает с тем, что видно в игре. Сами клубы живут в узле дыма уровня
## (см. smoke.gd), поэтому шлейф остаётся на экране и после того, как снаряд исчез.
##
## Зажигается сопло через ignite: выбрасывает облако зажигания и дальше дымит. Повторный
## вызов ничего не делает, поэтому зажигать можно не сторожа состояние. Гаснет — только
## через set_burning: снаряду это не нужно, он дымит до конца полёта, а двигатель корабля
## так глохнет на нырке и так же переключается между своими двумя соплами, обычным
## и форсажным (см. ship_engine.gd). Нужно ли облако при каждом запуске, решает
## ignition_burst того сопла: ноль — запуск без облака.
##
## Выхлоп летит назад по локальной оси Y узла — вниз на картинке сцены. Узел поворачивается
## вместе со снарядом, так что в сцене его достаточно поставить на место, разворачивать
## не нужно. Размеры и скорости — в пикселях экрана: масштаб сцены на них не влияет.

@export_group("Emission")
## Сколько клубов в секунду выпускает сопло в полёте. Больше — шлейф плотнее и ровнее,
## но и клубов на экране больше; меньше — шлейф распадается на отдельные комки.
@export var rate := 45.0
## Сколько клубов уходит разом в одно облако — при зажигании или по разовому burst.
## 0 — облака нет совсем: двигатель зажигается без вспышки, а хлопок по burst не даёт
## ничего.
@export_range(0, 64, 1, "or_greater") var ignition_burst := 24
## Скорость, с которой облако зажигания разлетается во все стороны, пикселей в секунду.
## Больше — облако пышнее и шире.
@export var burst_speed := 90.0
## Скорость выхлопа относительно снаряда, пикселей в секунду. Больше — дым дальше вылетает
## назад из сопла, прежде чем воздух его остановит; меньше скорости снаряда — клубы
## какое-то время летят вперёд вслед за ним.
@export var exhaust_speed := 150.0
## Разброс направления выхлопа, градусов в каждую сторону от оси сопла. 0 — клубы вылетают
## строго назад; больше — шлейф с самого сопла шире и неровнее. У быстрого выхлопа угол
## работает жёстче, чем кажется: на 1000 пикселях в секунду каждый градус — это ещё
## 17 пикселей в секунду в сторону, поэтому шаг здесь дробный.
@export_range(0.0, 90.0, 0.1) var exhaust_spread := 12.0

@export_group("Puff")
## Размер клуба при вылете, пикселей. Это край, за которым плотности уже нет; видимая
## часть примерно вдвое уже.
@export_range(1.0, 64.0, 0.5, "or_greater") var start_size := 10.0
## Размер клуба к концу жизни, пикселей. Разница со start_size — это то, насколько
## расплывается шлейф. Масса дыма при этом сохраняется: чем шире клуб, тем он бледнее.
@export_range(1.0, 256.0, 0.5, "or_greater") var end_size := 36.0
## Сколько секунд живёт клуб. Больше — шлейф длиннее и дольше висит на экране.
@export var lifetime := 2.5
## Плотность клуба при вылете. Больше — шлейф гуще и светлее в сердцевине; пороги
## цветов задаются в материале узла дыма.
@export_range(0.0, 3.0, 0.01, "or_greater") var density := 1.2
## Сколько секунд клуб остаётся горячим и светится цветом пламени. Больше — огненный
## участок шлейфа за соплом длиннее.
@export var hot_time := 0.12
## Каким пламенем светится горячий дым: цвета для каждого варианта заданы в материале
## узла дыма.
@export var flame: Smoke.Flame = Smoke.Flame.ROCKET

var _smoke: Smoke
var _burning := false
var _tracking := false
var _previous_position := Vector2.ZERO
var _velocity := Vector2.ZERO
# Накопленная дробная часть клубов: при 30 клубах в секунду и 60 кадрах клуб выходит
# через кадр, а не по половинке каждый кадр.
var _emit_debt := 0.0


func _ready() -> void:
	_smoke = get_tree().get_first_node_in_group(Smoke.GROUP) as Smoke


# Снаряд двигает себя в своём _physics_process, а дочерние узлы обрабатываются после
# родителя, поэтому здесь позиция уже обновлена за этот кадр.
func _physics_process(delta: float) -> void:
	var position_now := global_position
	# Первый кадр только запоминает позицию: снаряд ставят на место уже после добавления
	# в дерево, и сдвиг от нуля до шахты дал бы выхлопу огромную скорость.
	if _tracking:
		_velocity = (position_now - _previous_position) / delta
	else:
		_previous_position = position_now
		_tracking = true
	if _burning:
		_emit_along(_previous_position, position_now, delta)
	_previous_position = position_now


## Зажигает двигатель: выбрасывает облако зажигания, если оно настроено, и начинает дымить.
## Повторный вызов у уже дымящего сопла ничего не делает, поэтому его можно звать на каждую
## пересборку состояния, не отслеживая переход.
func ignite() -> void:
	if _burning:
		return
	_burning = true
	burst()


## Выбрасывает одно облако, не запуская постоянный выхлоп. Так дымит нырок корабля: сопло
## на корпусе даёт разовый хлопок и снова молчит (см. spaceship.gd). Зажигание пользуется
## этим же методом, поэтому облако у обоих настраивается одними полями.
func burst() -> void:
	for i in ignition_burst:
		# sqrt растягивает разброс к краю круга: без него клубы кучковались бы в центре.
		var scatter := Vector2.from_angle(randf() * TAU) * burst_speed * sqrt(randf())
		_emit(global_position, 0.0, scatter)


## Гасит сопло, а с true — запускает его без облака зажигания. Гасить больше нечем: ignite
## умеет только зажечь, поэтому двигатель корабля глохнет на нырке именно так. Для запуска
## обычно нужен ignite — он то же самое, но с облаком, если оно настроено.
func set_burning(value: bool) -> void:
	_burning = value


## Экземпляр снаряда, которому принадлежит сопло. По нему дым узнаёт свой выхлоп
## и не даёт следу этого же снаряда его раздувать, см. wake.gd.
func get_source_id() -> int:
	return owner.get_instance_id()


# Клубы раскладываются по отрезку, который сопло прошло за кадр. Если выпускать их
# из текущей точки, шлейф быстрого снаряда распался бы на комки с пустотами между кадрами.
func _emit_along(from: Vector2, to: Vector2, delta: float) -> void:
	_emit_debt += rate * delta
	while _emit_debt >= 1.0:
		_emit_debt -= 1.0
		# Сколько кадра прошло с вылета этого клуба: 0 — вылетел только что, у самого сопла;
		# ближе к 1 — в начале кадра, когда сопло было ещё позади.
		var lag := _emit_debt / (rate * delta)
		_emit(to.lerp(from, lag), lag * delta, Vector2.ZERO)


# Выхлоп вылетает назад относительно снаряда, поэтому в скорость клуба входит и скорость
# самого снаряда: у быстрой ракеты клуб какое-то время летит вперёд, пока воздух его не остановит.
func _emit(nozzle_position: Vector2, age: float, extra_velocity: Vector2) -> void:
	var spread := deg_to_rad(randf_range(-exhaust_spread, exhaust_spread))
	var direction := Vector2.DOWN.rotated(global_rotation + spread)
	var velocity := _velocity + direction * exhaust_speed + extra_velocity
	# Только что вышедший газ занимает место позади среза сопла, а не вокруг него, поэтому
	# центр клуба отодвинут назад на его собственный радиус. Иначе ближняя половина клуба
	# легла бы вперёд, на корпус снаряда, и сопло пришлось бы ставить в сцене ниже,
	# чем оно нарисовано.
	var origin := nozzle_position + direction * start_size
	# Клуб, вылетевший age секунд назад, успел отлететь от сопла.
	_smoke.add_puff(origin + velocity * age, velocity, age, self)
