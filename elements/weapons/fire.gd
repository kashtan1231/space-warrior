extends AnimatedSprite2D
class_name Fire

## Пламя, горящее на обшивке в месте попадания ракеты. Ставит его компонент горючести
## корабля, см. flammable.gd, и кладёт дочерним узлом спрайта корпуса: позиция, наклон
## и масштаб корабля достаются даром, а при взрыве корпус прячется вместе с очагами.
##
## Огонь идёт в две стадии. Сначала один раз проигрывается разгорание ignite — от искры
## до ровного пламени, — а как только оно доиграло, включается бесконечный burn и крутится
## до самого затухания. Поэтому в сцене нужны обе анимации: ignite с выключенным Loop,
## burn — с включённым, иначе переход не состоится. Где кончается разгорание, решают кадры,
## положенные в ignite, а не число в коде: короче анимация — раньше начинается горение.
##
## Сам спрайт держит тот поворот, который задан ему в сцене, и не заваливается вместе
## с корпусом: пламя тянется вверх, а не вдоль накренившегося корабля.

## Сколько секунд горит пламя, считая от попадания. 0 — горит, пока жив корабль: так удобно
## смотреть анимацию в редакторе и так делается неугасающий пожар. В это время входит и
## разгорание, поэтому значение меньше длительности ignite оставит от вспышки огрызок.
@export var burn_time := 2.0
## За сколько секунд пламя уходит в прозрачность в конце горения. Это время входит
## в burn_time, а не добавляется к нему, поэтому огонь пропадает ровно через burn_time.
## 0 — гаснет разом, целым кадром.
@export var fade_time := 0.5

# Имена анимаций в сцене огня.
const IGNITE := &"ignite"
const BURN := &"burn"

var _base_rotation := 0.0


func _ready() -> void:
	# Поворот снимается до первого выпрямления, иначе наклон корпуса, на который огонь
	# только что сел, остался бы в нём навсегда.
	_base_rotation = rotation
	_hold_rotation()
	# Подписка одноразовая: сигнал нужен ровно один раз, на переходе от разгорания
	# к горению. У зацикленного burn он всё равно не придёт никогда.
	animation_finished.connect(_play_burn_loop, CONNECT_ONE_SHOT)
	play(IGNITE)
	if burn_time > 0.0:
		_schedule_burnout()


# Корабль кренится в _physics_process, а _process кадра идёт после него, поэтому огонь
# выпрямляется по уже обновлённому наклону и не отстаёт на кадр.
func _process(_delta: float) -> void:
	_hold_rotation()


# Разгорание доиграло: дальше пламя просто горит по кругу, пока его не погасит время.
func _play_burn_loop() -> void:
	play(BURN)


# Отсчёт жизни очага. Идёт своим чередом, не оглядываясь на анимацию: гаснуть огонь может
# и посреди прохода burn — на глаз это незаметно, зато время горения остаётся ровно тем,
# что выставлено в инспекторе, при любом числе кадров и любой их скорости.
func _schedule_burnout() -> void:
	# Угасание не может быть длиннее самого горения: иначе огонь начинал бы гаснуть
	# раньше, чем появился.
	var fade := minf(fade_time, burn_time)
	var tween := create_tween()
	tween.tween_interval(burn_time - fade)
	tween.tween_property(self, "modulate:a", 0.0, fade)
	tween.tween_callback(queue_free)


# Корпус заваливается в вираже, а пламя всё равно стоит так, как поставлено в сцене огня.
func _hold_rotation() -> void:
	global_rotation = _base_rotation
