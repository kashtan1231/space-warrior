shader_type canvas_item;

// Заливает спрайт белым, сохраняя прозрачность: получается белый силуэт.
// modulate так не умеет — он умножает цвет, а умножение на белый оставляет картинку как есть.

// 0 — обычный спрайт, 1 — полностью белый силуэт.
uniform float flash : hint_range(0.0, 1.0) = 0.0;


void fragment() {
	// COLOR здесь уже содержит текстуру, умноженную на modulate, поэтому затемнение
	// нырка и мигание неуязвимости продолжают работать вместе со вспышкой.
	COLOR.rgb = mix(COLOR.rgb, vec3(1.0), flash);
}
